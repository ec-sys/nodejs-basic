NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/zenblog
PORT=3000

# JWT Configuration
ACCESS_TOKEN_SECRET=my_secret_key
REFRESH_TOKEN_SECRET=refresh_secret_key
ACCESS_TOKEN_EXPIRY = '1d'
REFRESH_TOKEN_EXPIRY = '30d'

# Elasticsearch Configuration
ELASTIC_NODE=http://localhost:9200

# Uploads
UPLOAD_IMAGE_PATH=../../uploads/images
UPLOAD_DOCUMENT_PATH=../../uploads/documents
UPLOAD_TEXT_PATH=../../uploads/texts

# Redis
REDIS_URL=redis://localhost:6379